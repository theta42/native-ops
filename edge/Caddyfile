{
	email ops@opsavor.app
	# Per-site blocks are generated by the manager into /etc/caddy/sites/.
}

# Strip forged identity headers from the retired OpenAI Sites hosting.
# The edge is a plain reverse proxy; it removes any client-supplied identity
# headers before forwarding upstream so no handler can trust a spoofed header.
(strip-forged-identity) {
	request_header -Oai-Authenticated-User-Id
	request_header -Oai-Authenticated-User-Email
	request_header -Oai-Authenticated-User-Full-Name
	request_header -Oai-Authenticated-User-Full-Name-Encoding
}

# Manager UI (private ops host).
manage.opsavor.app {
	tls {
		dns digitalocean {env.DO_API_TOKEN}
	}
	import strip-forged-identity
	reverse_proxy manager:3001
}

# Git hosting.
git.opsavor.app {
	tls {
		dns digitalocean {env.DO_API_TOKEN}
	}
	import strip-forged-identity
	reverse_proxy gitea:3000
}

# Plane project management.
plane.opsavor.app {
	tls {
		dns digitalocean {env.DO_API_TOKEN}
	}
	import strip-forged-identity
	reverse_proxy plane:80
}

# BookStack documentation.
docs.opsavor.app {
	tls {
		dns digitalocean {env.DO_API_TOKEN}
	}
	import strip-forged-identity
	reverse_proxy bookstack:80
}

# Restaurant white-labels. Wildcard cert; per-site blocks come from
# /etc/caddy/sites/*.caddy (one file per slug, written by the manager).
*.opsavor.app {
	tls {
		dns digitalocean {env.DO_API_TOKEN}
	}
	import strip-forged-identity

	# Unknown slugs fall through to the manager, which renders "unknown
	# restaurant" instead of leaking the edge internals.
	reverse_proxy manager:3001
}

import /etc/caddy/sites/*.caddy
